;
; pb_i2s.pio — PIO I2S 发送器（16bit 立体声；单声道样本左右各填一份）
;
; 改编自 Raspberry Pi pico-extras 的 audio_i2s.pio（BSD-3-Clause，
; Copyright 2020 Raspberry Pi (Trading) Ltd.）。
;
; side-set 两个相邻引脚：base=BCLK、base+1=LRCLK；另有一个 OUT 引脚输出数据。
; 自动 pull 阈值 32、MSB 在前（shift to left）。每个 FIFO 32bit 字：
;   高 16bit 在 LRCLK=0 阶段送出，低 16bit 在 LRCLK=1 阶段送出；
; 单声道模式下两半写同一个值，L/R 如何接线都不影响。
; 每个完整帧（32 个数据位）共 64 个 PIO 周期。
;
.program pb_i2s
.side_set 2

                    ;        /--- LRCLK
                    ;        |/-- BCLK
bitloop1:           ;        ||
    out pins, 1       side 0b10
    jmp x-- bitloop1  side 0b11
    out pins, 1       side 0b00
    set x, 14         side 0b01

bitloop0:
    out pins, 1       side 0b00
    jmp x-- bitloop0  side 0b01
    out pins, 1       side 0b10
public entry_point:
    set x, 14         side 0b11
